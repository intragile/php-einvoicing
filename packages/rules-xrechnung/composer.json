{
    "name": "intragile/einvoicing-rules-xrechnung",
    "description": "The KoSIT XRechnung 2.6.0 validation rules compiled to PHP arrays, the scenario table of the KoSIT validator configuration 2026-08-31 and the UBL 2.1 and CII D16B schemas it uses, for intragile/php-einvoicing.",
    "keywords": [
        "xrechnung",
        "en16931",
        "e-invoicing",
        "schematron",
        "validation",
        "kosit",
        "ubl",
        "cii"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "homepage": "https://intragile.eu",
    "support": {
        "issues": "https://github.com/intragile/einvoicing-rules-xrechnung/issues",
        "source": "https://github.com/intragile/einvoicing-rules-xrechnung"
    },
    "authors": [
        {
            "name": "IntrAgile Kft.",
            "email": "info@intragile.eu",
            "homepage": "https://intragile.eu"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "conflict": {
        "intragile/php-einvoicing": "<1.0 || >=2.0"
    },
    "autoload": {
        "psr-4": {
            "IntrAgile\\EInvoicing\\Rules\\XRechnung\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.3.x-dev"
        }
    },
    "minimum-stability": "stable"
}
