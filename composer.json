{
    "name": "intragile/php-einvoicing",
    "description": "Framework-agnostic EN 16931 e-invoicing core for PHP: invoice model, exact decimal totals, UBL and CII reading and writing, pure-PHP validation against the official CEN EN 16931 and Peppol BIS 3 Schematron rules, XRechnung 3.0.2 validation like the KoSIT validator, ZUGFeRD and Factur-X (PDF/A-3 embedding and reading in pure PHP, validation against the official 1.09.2 rules), and Peppol sending, receiving and participant lookup (SML, SMP, Directory).",
    "keywords": [
        "en16931",
        "e-invoicing",
        "einvoice",
        "ubl",
        "cii",
        "peppol",
        "peppol-access-point",
        "sbdh",
        "smp",
        "invoice",
        "xml",
        "validation",
        "validator",
        "schematron",
        "xrechnung",
        "kosit",
        "zugferd",
        "factur-x",
        "pdf-a-3"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://intragile.eu",
    "support": {
        "issues": "https://github.com/intragile/php-einvoicing/issues",
        "source": "https://github.com/intragile/php-einvoicing",
        "security": "https://github.com/intragile/php-einvoicing/security/policy"
    },
    "authors": [
        {
            "name": "IntrAgile Kft.",
            "email": "info@intragile.eu",
            "homepage": "https://intragile.eu"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-zlib": "*",
        "brick/math": "^0.14.8 || ^1.0",
        "intragile/einvoicing-rules-en16931": "^1.0",
        "phpseclib/phpseclib": "^3.0.47",
        "psr/http-client": "^1.0.1",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1|^2.0"
    },
    "require-dev": {
        "intragile/einvoicing-rules-facturx": "^1.0",
        "intragile/einvoicing-rules-xrechnung": "^1.0",
        "laravel/pint": "^1.0",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5.50"
    },
    "conflict": {
        "intragile/einvoicing-rules-facturx": "<1.0 || >=2.0",
        "intragile/einvoicing-rules-xrechnung": "<1.0 || >=2.0"
    },
    "suggest": {
        "ext-zip": "Needed for KSeF batch sessions and invoice export packages (ZIP archives)",
        "guzzlehttp/guzzle": "A PSR-18 HTTP client and PSR-17 factories for the Peppol transports",
        "intragile/einvoicing-rules-facturx": "The Factur-X 1.09.2 rules and profile schemas (Apache-2.0), needed for writing and validating Factur-X/ZUGFeRD profiles other than XRECHNUNG",
        "intragile/einvoicing-rules-xrechnung": "The KoSIT XRechnung rules, scenario table and schemas (Apache-2.0), needed for XRechnung validation",
        "symfony/http-client": "A PSR-18 HTTP client (with nyholm/psr7 for the PSR-17 factories) for the Peppol transports"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/rules-en16931",
            "options": {
                "versions": {
                    "intragile/einvoicing-rules-en16931": "1.0.0"
                }
            }
        },
        {
            "type": "path",
            "url": "packages/rules-facturx",
            "options": {
                "versions": {
                    "intragile/einvoicing-rules-facturx": "1.0.0"
                }
            }
        },
        {
            "type": "path",
            "url": "packages/rules-xrechnung",
            "options": {
                "versions": {
                    "intragile/einvoicing-rules-xrechnung": "1.0.0"
                }
            }
        }
    ],
    "bin": [
        "bin/einvoicing-rules"
    ],
    "autoload": {
        "psr-4": {
            "IntrAgile\\EInvoicing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IntrAgile\\EInvoicing\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "fetch-official": "@php bin/fetch-official.php",
        "compile-rules": [
            "@php bin/compile-schematron.php",
            "@php bin/compile-xrechnung.php",
            "@php bin/compile-facturx.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
