<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="EInvoicing"><directory>tests</directory></testsuite>
    </testsuites>
    <!-- The oracle group needs SaxonC, the kosit-oracle group needs the KoSIT validator daemon
         (docker/kosit/run.sh), the verapdf group needs Docker and the veraPDF image
         (docker/verapdf/run.sh), the network group reaches the internet, the recommand-live
         group needs Recommand API credentials, the b2brouter-live group needs a B2Brouter sandbox
         API key, the einvoicebe-live group needs an e-invoice.be sandbox API key, the
         performance group asserts wall-clock bounds that can flake on a loaded machine, the
         release-artefacts group needs headless Chrome (CHROME_BIN) and writes
         build/release-artefacts, and the release-gate group checks those artefacts against the
         official validators; run them explicitly with the group option of PHPUnit. The
         france-rules group compiles the French rules from the France_RFE checkout (the france
         option of composer fetch-official) and is skipped without it, so it stays in the default
         run. -->
    <groups>
        <exclude><group>oracle</group><group>kosit-oracle</group><group>verapdf</group><group>network</group><group>recommand-live</group><group>b2brouter-live</group><group>einvoicebe-live</group><group>performance</group><group>release-artefacts</group><group>release-gate</group></exclude>
    </groups>
    <!-- The suite needs about 250 MB on PHP 8.5, above the stock 128M limit of PHP images. -->
    <php>
        <ini name="memory_limit" value="512M"/>
    </php>
    <source>
        <include><directory>src</directory></include>
    </source>
</phpunit>
