<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="EInvoicing"><directory>tests</directory></testsuite>
    </testsuites>
    <!-- The oracle group needs SaxonC, the network group reaches the internet, the recommand-live
         group needs Recommand API credentials and the performance group asserts wall-clock bounds
         that can flake on a loaded machine; run them explicitly with the group option of PHPUnit. -->
    <groups>
        <exclude><group>oracle</group><group>network</group><group>recommand-live</group><group>performance</group></exclude>
    </groups>
    <!-- The suite needs about 160 MB on PHP 8.3, above the stock 128M limit of PHP images. -->
    <php>
        <ini name="memory_limit" value="512M"/>
    </php>
    <source>
        <include><directory>src</directory></include>
    </source>
</phpunit>
