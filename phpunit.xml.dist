<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="EInvoicing"><directory>tests</directory></testsuite>
    </testsuites>
    <!-- The oracle group needs SaxonC and the network group downloads from GitHub; run them
         explicitly with the group option of PHPUnit. -->
    <groups>
        <exclude><group>oracle</group><group>network</group></exclude>
    </groups>
    <source>
        <include><directory>src</directory></include>
    </source>
</phpunit>
