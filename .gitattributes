* text=auto eol=lf
*.zip binary
# Official CEN artefacts are kept byte-for-byte as published.
/tests/fixtures/official/cen-1.3.17/** -text -eol
/tests/fixtures/official/cen-1.3.16/** -text -eol
# The KoSIT artefacts are hashed byte for byte (xrechnung.sha256).
/tests/fixtures/official/xrechnung/** -text -eol
# The schemas of the XRechnung rules package are unmodified copies of the KoSIT ones.
/packages/rules-xrechnung/schemas/** -text -eol
# The ISO Schematron skeleton is kept byte-for-byte as pinned in its SOURCE.md.
/tests/fixtures/iso-schematron/*.xsl -text -eol
/tests/fixtures/iso-schematron/LICENSE -text -eol

# Development files are left out of the Composer dist archive.
/.github            export-ignore
# bin/einvoicing-rules ships with the package; the other scripts are development tools.
/bin/compile-schematron.php  export-ignore
/bin/compile-xrechnung.php   export-ignore
/bin/fetch-official.php      export-ignore
/bin/generate-codelists.php  export-ignore
/bin/generate-model-doc.php  export-ignore
/docker             export-ignore
/packages           export-ignore
/tests              export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpstan.neon.dist  export-ignore
/phpunit.xml.dist   export-ignore
/pint.json          export-ignore
/CHANGELOG.md       export-ignore
